CONFIG_CCACHE=y
CONFIG_LTO=y
CONFIG_OPTION_BACKEND_NONE=y
CONFIG_COMPRESS_RAMSTAGE_ZSTD=y
# CONFIG_COLLECT_TIMESTAMPS is not set
CONFIG_VENDOR_LENOVO=y
CONFIG_PCIEXP_L1_SUB_STATE=y
CONFIG_PCIEXP_CLK_PM=y
# CONFIG_DRIVERS_INTEL_WIFI is not set
CONFIG_IFD_BIN_PATH="x230_bins/flashregion_0_flashdescriptor.bin"
CONFIG_ME_BIN_PATH="x230_bins/flashregion_2_intel_me.bin"
CONFIG_GBE_BIN_PATH="x230_bins/flashregion_3_gbe.bin"
CONFIG_EDK2_BOOT_TIMEOUT=0
CONFIG_HAVE_IFD_BIN=y
CONFIG_BOARD_LENOVO_X230=y
CONFIG_EDK2_BOOTSPLASH_FILE="empty.jpg"
CONFIG_POWER_STATE_ON_AFTER_FAILURE=y
CONFIG_USE_X86_64_SUPPORT=y
CONFIG_X2APIC_ONLY=y
CONFIG_HIDE_MEI_ON_ERROR=y
# CONFIG_PCIEXP_HOTPLUG is not set
# CONFIG_INTEL_CHIPSET_LOCKDOWN is not set
CONFIG_H8_SUPPORT_BT_ON_WIFI=y
CONFIG_H8_FN_CTRL_SWAP=y
CONFIG_HAVE_ME_BIN=y
CONFIG_HAVE_GBE_BIN=y
CONFIG_DRIVERS_EFI_VARIABLE_STORE=y
CONFIG_VBT_CBFS_COMPRESSION_LZ4=y
CONFIG_DRIVERS_PS2_KEYBOARD=y
# CONFIG_TPM1 is not set
# CONFIG_BOOTBLOCK_CONSOLE is not set
# CONFIG_POSTCAR_CONSOLE is not set
# CONFIG_SQUELCH_EARLY_SMP is not set
# CONFIG_CONSOLE_CBMEM is not set
CONFIG_PAYLOAD_EDK2=y
# CONFIG_EDK2_HAVE_EFI_SHELL is not set
# CONFIG_EDK2_SECURE_BOOT_SUPPORT is not set
CONFIG_EDK2_DISABLE_TPM=y
CONFIG_EDK2_CUSTOM_BUILD_PARAMS="--pcd gEfiMdePkgTokenSpaceGuid.PcdUsbTransferTimeoutValue=1000"
CONFIG_COMPRESSED_PAYLOAD_ZSTD=y
