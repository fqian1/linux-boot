CONFIG_LTO=y
CONFIG_USE_UEFI_VARIABLE_STORE=y
CONFIG_COMPRESS_RAMSTAGE_ZSTD=y
CONFIG_VENDOR_LENOVO=y
CONFIG_CONSOLE_SERIAL=y
CONFIG_IFD_BIN_PATH="t480s/flashregion_0_flashdescriptor.bin"
CONFIG_ME_BIN_PATH="t480s/flashregion_2_intel_me.bin"
CONFIG_GBE_BIN_PATH="t480s/flashregion_3_gbe.bin"
CONFIG_INTEL_OC_MAILBOX_ENABLE_UNDERVOLTING=y
CONFIG_HAVE_IFD_BIN=y
CONFIG_BOARD_LENOVO_T480S=y
CONFIG_LINUX_COMMAND_LINE="console=ttyS0,115200 console=tty1"
CONFIG_H8_FN_CTRL_SWAP=y
CONFIG_HAVE_ME_BIN=y
CONFIG_HAVE_GBE_BIN=y
CONFIG_GENERIC_LINEAR_FRAMEBUFFER=y
CONFIG_DRIVERS_EFI_VARIABLE_STORE=y
CONFIG_DRIVERS_OPTION_CFR=y
CONFIG_SMMSTORE=y
CONFIG_DRIVERS_GENERIC_CBFS_SERIAL=y
CONFIG_DRIVERS_PS2_KEYBOARD=y
# CONFIG_TPM2 is not set
# CONFIG_CONSOLE_CBMEM is not set
# CONFIG_CONSOLE_USE_ANSI_ESCAPES is not set
CONFIG_PAYLOAD_LINUX=y
CONFIG_COMPRESSED_PAYLOAD_NONE=y
# CONFIG_COMPRESS_SECONDARY_PAYLOAD is not set
