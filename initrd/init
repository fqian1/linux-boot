#!/bin/sh

PATH=/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

mkdir -p /mnt/usb /mnt/img /mnt/disk

try_kexec() {
	kernel=$1
	initrd=$2
	cmdline=$3

	if [ -n "$initrd" ]; then 
		kexec -l "$kernel" --initrd="$initrd" --command-line="$cmdline" || return 1
	else 
		kexec -l "$kernel" --command-line="$cmdline" || return 1
	fi

	sync
	kexec -e
	return 1
}

is_usb() {
	case "$(readlink -f "/sys/block/$1/device" 2>/dev/null)" in
		*usb*) return 0 ;;
		*) return 1 ;;
	esac
}

boot_fs() {
	root="$1"
	fallback_cmdline="$2"

	kernel=$(find "$root/boot" "$root" -maxdepth 2 \( -name 'vmlinuz*' -o -name 'bzImage*' -o -name 'linux*' \) 2>/dev/null | head -n 1 )
	[ -n "$kernel" ] || return 1
	
	initrd=$(find "$root/boot" "$root" -maxdepth 2 \( -name 'initrd*' -o -name 'initramfs*' \) 2>/dev/null | head -n 1 )
	
	if [ -f "$root/boot/cmdline.txt" ]; then cmdline=$(cat "$root/boot/cmdline.txt")
	elif [ -f "$root/boot/cmdline" ]; then cmdline=$(cat "$root/boot/cmdline")
	else cmdline="$fallback_cmdline"
	fi

	try_kexec "$kernel" "$initrd" "$cmdline"
	return 1
}

boot_img() {
	img="$1"

	loop=$(losetup -f) || return 1
	losetup -P "$loop" "$img" || return 1

	for i in $(seq 1 20); do
		if [ -e "${loop}p1" ]; then break; fi
		usleep 100000
	done
	
	for p in "${loop}p"* "$loop"; do
		[ -e "$p" ] || continue
		if mount -o ro "$p" /mnt/img 2>/dev/null; then
			boot_fs /mnt/img "ro quiet"
			umount /mnt/img 2>/dev/null
		fi
	done

	losetup -d "$loop" 2>/dev/null
	return 1
}

echo "[INIT]: Polling devices"
for i in $(seq 1 30); do
	for dev in /sys/block/sd* /sys/block/nvme* /sys/block/mmcblk*; do
		[ -e "$dev" ] && break
	done
	usleep 100000
done

echo "[INIT]: Polling done, scanning for usb"
for blk in /sys/block/sd* /sys/block/mmcblk*; do
	[ -e "$blk" ] || continue
	name=$(basename "$blk")
	is_usb "$name" || continue
	
	for part in /dev/"$name"[0-9]* /dev/"$name"p[0-9]* /dev/"$name"; do
		[ -b "$part" ] || continue
		mount -o ro "$part" /mnt/usb 2>/dev/null || continue
		
		img=$(find /mnt/usb -maxdepth 2 -name '*.img' -o -name '*.IMG' 2>/dev/null | head -n 1)

		if [ -n "$img" ]; then
		       boot_img "$img"
		fi

		umount /mnt/usb 2>/dev/null
	done
done

echo "[INIT]: No usb found, kexec'ing from disk"
for blk in /sys/block/sd* /sys/block/nvme*; do
	[ -e "$blk" ] || continue
	name=$(basename "$blk")
	is_usb "$name" && continue
	
	for part in /dev/"$name"[0-9]* /dev/"$name"p[0-9]*; do
		[ -b "$part" ] || continue

		mount -o ro "$part" /mnt/disk 2>/dev/null || continue

		uuid=$(blkid -s UUID -o value "$part" 2>/dev/null)
		partuuid=$(blkid -s PARTUUID -o value "$part" 2>/dev/null)

		if [ -n "$uuid" ]; then
			fallback="root=UUID=$uuid ro quiet"
		elif [ -n "$partuuid" ]; then
			fallback="root=PARTUUID=$partuuid ro quiet"
		else
			fallback="root=$part ro quiet"
		fi

		boot_fs /mnt/disk "$fallback"
		umount /mnt/disk 2>/dev/null
	done
done

echo "[INIT]: No kernel found, dropping to shell"
exec sh -i
